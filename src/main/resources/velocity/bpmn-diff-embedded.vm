<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <link rel="stylesheet" href="${contextPath}/download/resources/com.github.criew.bitbucket.bitbucket-bpmn-support:bpmn-diff-resources/app.css"/>
    <link rel="stylesheet" href="${contextPath}/download/resources/com.github.criew.bitbucket.bitbucket-bpmn-support:bpmn-diff-resources/bpmnio.css"/>
    <link rel="stylesheet" href="${contextPath}/download/resources/com.github.criew.bitbucket.bitbucket-bpmn-support:bpmn-diff-resources/diff.css"/>
    <style>
        body { margin: 0; padding: 0; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        .bpmn-diff-content { height: 100vh; display: flex; flex-direction: column; }
        .bpmn-diff-header { display: flex; align-items: center; padding: 8px 16px; background: #f4f5f7; border-bottom: 1px solid #dfe1e6; flex-shrink: 0; }
        .bpmn-diff-header h2 { font-size: 14px; margin: 0; flex: 1; }
        .bpmn-diff-legend { display: flex; gap: 12px; }
        .legend-item { font-size: 12px; padding: 2px 8px; border-radius: 3px; border: 1px solid; }
        .legend-added { color: #006644; border-color: #006644; background: #e3fcef; }
        .legend-removed { color: #bf2600; border-color: #bf2600; background: #ffebe6; }
        .legend-changed { color: #ff8b00; border-color: #ff8b00; background: #fff3e0; }
        .legend-layout { color: #0747a6; border-color: #0747a6; background: #deebff; }
        .di-panels { display: flex; flex: 1; min-height: 0; }
        .di-container { flex: 1; display: flex; flex-direction: column; border: 1px solid #dfe1e6; position: relative; }
        .di-container.left { border-right: none; }
        .di-label { font-size: 11px; font-weight: 600; color: #6b778c; text-transform: uppercase; padding: 4px 8px; background: #f4f5f7; }
        .canvas { flex: 1; }
    </style>
</head>
<body>
<div class="bpmn-diff-content">
    <div class="bpmn-diff-header">
        <h2>BPMN Visual Diff</h2>
        <div class="bpmn-diff-legend">
            <span class="legend-item legend-added">Added</span>
            <span class="legend-item legend-removed">Removed</span>
            <span class="legend-item legend-changed">Changed</span>
            <span class="legend-item legend-layout">Layout</span>
        </div>
    </div>
    <div class="di-panels">
        <div class="di-container left">
            <div class="di-label">Source (from)</div>
            <div class="canvas" id="canvas-left"></div>
        </div>
        <div class="di-container right">
            <div class="di-label">Target (to)</div>
            <div class="canvas" id="canvas-right"></div>
        </div>
    </div>
</div>
<script>window.__bpmnContextPath = "$contextPath";</script>
<script src="${contextPath}/download/resources/com.github.criew.bitbucket.bitbucket-bpmn-support:bpmn-diff-resources/bpmn_diff.bundle.js"></script>
</body>
</html>
