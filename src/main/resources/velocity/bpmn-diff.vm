<html>
<head>
    <meta name="decorator" content="atl.general"/>
    <title>BPMN Visual Diff</title>
    $webResourceManager.requireResource("com.github.criew.bitbucket.bitbucket-bpmn-support:bpmn-diff-resources")
</head>
<body>
<div class="bpmn-diff-content">
    <div class="bpmn-diff-header">
        <h2>BPMN Visual Diff</h2>
        <div class="bpmn-diff-legend">
            <span class="legend-item legend-added">Added</span>
            <span class="legend-item legend-removed">Removed</span>
            <span class="legend-item legend-changed">Changed</span>
            <span class="legend-item legend-layout">Layout</span>
        </div>
    </div>
    <div class="di-container left">
        <div class="di-label">Source (from)</div>
        <div class="canvas" id="canvas-left"></div>
    </div>
    <div class="di-container right">
        <div class="canvas" id="canvas-right"></div>
        <div class="di-label">Target (to)</div>
    </div>
    <div id="changes-overview" class="collapsed">
        <div class="io-control show-hide-toggle">List of Changes</div>
        <div class="io-control changes"></div>
    </div>
</div>
</body>
</html>
